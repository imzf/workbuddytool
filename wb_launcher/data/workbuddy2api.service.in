[Unit]
Description=WorkBuddy2API 面板（CodeBuddy 账号池 · OpenAI 兼容网关）
Documentation=https://github.com/misakano7545/workbuddy2api-panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@WORK_DIR@
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=3
SyslogIdentifier=workbuddy2api

# 账号、配置与数据都在安装目录里，只放开这一处写权限。
# 注意：不要加 PrivateTmp=true，否则安装在 /tmp 下的目录会在私有 /tmp 里"消失"。
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@APP_DIR@
LimitNOFILE=65536

[Install]
WantedBy=default.target
